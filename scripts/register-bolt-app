#!/usr/bin/python3
"""Deduplicate default Desktop tiles and optionally register the Bolt launcher."""

import json
import os
from pathlib import Path
import stat
import sys
import tempfile


def merge_app(config, app):
    apps = config.setdefault("apps", [])
    if not isinstance(apps, list) or any(not isinstance(item, dict) for item in apps):
        raise ValueError("Sunshine apps must be an array of objects")
    for existing in apps:
        if existing.get("name") == app["name"]:
            # Repair stale desktop/Steam launch fields but preserve artwork,
            # preparation commands, and other user-customized settings.
            updated = {**app, **existing, "cmd": app["cmd"], "detached": app["detached"]}
            if existing.get("image-path") in (None, "", "desktop.png"):
                updated["image-path"] = app["image-path"]
            if updated == existing:
                return False
            existing.update(updated)
            return True
    apps.append(app)
    return True


def deduplicate_desktops(config):
    apps = config.get("apps", [])
    if not isinstance(apps, list) or any(not isinstance(item, dict) for item in apps):
        raise ValueError("Sunshine apps must be an array of objects")
    retained = []
    desktop_seen = False
    for item in apps:
        plain_desktop = (
            item.get("name") == "Desktop"
            and not item.get("cmd", "").strip()
            and not any(command.strip() for command in item.get("detached", []))
        )
        if plain_desktop:
            if desktop_seen:
                continue
            desktop_seen = True
        retained.append(item)
    if retained == apps:
        return False
    config["apps"] = retained
    return True


def main(config_path, app_path=None):
    path = Path(config_path)
    config = json.loads(path.read_text(encoding="utf-8"))
    changed = deduplicate_desktops(config)
    if app_path is not None:
        app = json.loads(Path(app_path).read_text(encoding="utf-8"))
        changed = merge_app(config, app) or changed
    if not changed:
        return

    metadata = path.stat()
    # Write alongside the original for an atomic replacement on its volume.
    fd, temporary = tempfile.mkstemp(prefix=".apps-bolt-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(config, output, indent=4)
            output.write("\n")
        os.chown(temporary, metadata.st_uid, metadata.st_gid)
        os.chmod(temporary, stat.S_IMODE(metadata.st_mode))
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("Updated Sunshine apps: deduplicated default Desktop tiles" +
          (" and registered native Bolt." if app_path else "."))


if __name__ == "__main__":
    main(*sys.argv[1:])
